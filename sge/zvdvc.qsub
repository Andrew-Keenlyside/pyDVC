#!/bin/bash
# zvDVC on your own data, on one Grid Engine GPU node (UCL CS pryor), inside zvdvc.sif:
# plan -> seed -> run -> finalize, one worker per GPU the job holds.
#
#   qsub -v CONFIG=/path/to/config.yaml sge/zvdvc.qsub          (from the zvDVC checkout)
#   qsub -v CONFIG=...,STAGES="run finalize" sge/zvdvc.qsub     # resume after a time-out
#
# Every stage is re-runnable: `run` skips tiles already written, so resubmitting after h_rt solves
# only the missing ones. The config's volumes, points, output and workdir must lie under BINDS.

# ---- Grid Engine resources ------------------------------------------------
#$ -N zvdvc
#$ -l h_rt=24:00:00
#$ -l gpu=true,gpu_type=h100
#$ -pe gpu 8
#$ -l tmem=48G                       # PER SLOT
#$ -R y
#$ -o /home/akeenlys/storage_main/bridge_project_data/logs/$JOB_NAME.$JOB_ID.log   # dir must already exist
#$ -S /bin/bash
#$ -cwd
#$ -j y

set -euo pipefail

# ---- SETTINGS -------------------------------------------------------------
SIF="${SIF:-/home/akeenlys/storage_main/bridge_project_data/containers/zvdvc.sif}"
BINDS="${BINDS:-/home/akeenlys/storage_main/bridge_project_data}"
CONFIG="${CONFIG:?set CONFIG: qsub -v CONFIG=/path/to/config.yaml sge/zvdvc.qsub}"
STAGES="${STAGES:-plan seed run finalize}"
BACKEND="${BACKEND:-fused}"
FINALIZE_ARGS="${FINALIZE_ARGS:---disp}"
ZVDVC_DEV_SRC="${ZVDVC_DEV_SRC:-}"
# ---------------------------------------------------------------------------

[ -f "$CONFIG" ] || { echo "FATAL: no config at $CONFIG" >&2; exit 1; }
CONFIG="$(cd "$(dirname "$CONFIG")" && pwd -P)/$(basename "$CONFIG")"
source "${SGE_O_WORKDIR:-$PWD}/sge/common.sh"
box test -r "$CONFIG" || { echo "FATAL: $CONFIG is not visible inside the container; add its directory to BINDS" >&2; exit 1; }

for stage in $STAGES; do
    echo; echo "==== zvdvc $stage  $(date -Is)"
    case "$stage" in
        plan|seed|run) box zvdvc "$stage" "$CONFIG" --backend "$BACKEND" ;;
        # shellcheck disable=SC2086
        finalize)      box zvdvc finalize "$CONFIG" $FINALIZE_ARGS ;;
        check)         box zvdvc check gpu ;;
        *) echo "FATAL: unknown stage '$stage' (plan, seed, run, finalize, check)" >&2; exit 1 ;;
    esac
done
echo; echo "done $(date -Is)"
